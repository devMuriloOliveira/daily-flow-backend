# Banco de dados PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require"

# Chave secreta para assinar tokens JWT (use um valor longo e aleatório)
JWT_SECRET="altere-esta-chave-por-um-segredo-forte"

# Porta do servidor (opcional)
PORT=3333
